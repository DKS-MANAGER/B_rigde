#!/bin/bash
cd "${0%/*}" || exit                                # Run from this directory

# Source OpenFOAM environment & user libraries
export FOAM_USER_LIBBIN=/home/hwre/OpenFOAM/hwre-v2412/platforms/linux64GccDPInt32Opt/lib
export FOAM_USER_APPBIN=/home/hwre/OpenFOAM/hwre-v2412/platforms/linux64GccDPInt32Opt/bin
source /usr/lib/openfoam/openfoam2412/etc/bashrc 2>/dev/null || true

# 1. Clean previous run files
if [ -f "./Allclean" ]; then
    ./Allclean
fi

# Ensure 0/p exists before decomposition
if [ -f "0/p_rbgh" ] && [ ! -f "0/p" ]; then
    cp 0/p_rbgh 0/p
fi

# 2. Generate multi-block structured mesh
echo "Generating polyMesh..."
blockMesh > log.blockMesh 2>&1

# 3. Generate finite-area mesh for bedload dynamics
echo "Generating faMesh..."
makeFaMesh > log.makeFaMesh 2>&1

# 4. Check mesh quality
echo "Checking mesh quality..."
checkMesh > log.checkMesh 2>&1

# 5. Decompose for parallel run (4 cores)
echo "Decomposing for 4 cores..."
decomposePar > log.decomposePar 2>&1

# 6. Execute solver in parallel
echo "Launching sedExnerFoam on 4 cores..."
mpirun -np 4 sedExnerFoam -parallel > log.sedExnerFoam 2>&1 &

echo "Solver started on 4 cores. Monitor progress with: tail -f log.sedExnerFoam"

# * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
