FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      faMeshDefinition;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

polyMeshPatches ( "bed" );

boundary
{
    inletFa
    {
        type patch;
        neighbourPolyPatch inlet;
    }

    outletFa
    {
        type patch;
        neighbourPolyPatch outlet;
    }

    sidesFa
    {
        type empty;
        neighbourPolyPatch frontAndBack;
    }
}

defaultPatch
{
    name empty;
    type empty;
}

