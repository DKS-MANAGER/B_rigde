FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 4.153;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 4.153;
    }

    outlet
    {
        type            zeroGradient;
    }

    bed
    {
        type            fuhrmanOmegaWallFunction;
        kn              0.00068;
        value           uniform 4.153;
    }

    top
    {
        type            slip;
    }

    bridge
    {
        type            omegaWallFunction;
        value           uniform 4.153;
    }

    frontAndBack
    {
        type            empty;
    }
}

