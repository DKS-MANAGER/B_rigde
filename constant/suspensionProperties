FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      suspensionProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

suspension          on;

diffusivity         turbulent;

wallDiffusivity
{
    alpha           5e-6;
}

fallModel
{
    type            Fredsoe;
}

hindranceModel
{
    type            none;
}

CsbMax              0.635;

